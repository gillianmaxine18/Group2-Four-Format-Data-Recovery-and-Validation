{
  "reporting_year": 2007,
  "data_dir": "data",
  "output_dir": "outputs",
  "tolerance": {
    "abs": 1e-08,
    "rel": 0
  },
  "schema": {
    "canonical_order": [
      "country",
      "continent",
      "year",
      "lifeExp",
      "pop",
      "gdpPercap"
    ],
    "dtypes": {
      "country": "string",
      "continent": "string",
      "year": "int64",
      "lifeExp": "float64",
      "pop": "int64",
      "gdpPercap": "float64"
    },
    "key": [
      "country",
      "year"
    ],
    "allowed_continents": [
      "Africa",
      "Americas",
      "Asia",
      "Europe",
      "Oceania"
    ],
    "allowed_years": [
      1952,
      1957,
      1962,
      1967,
      1972,
      1977,
      1982,
      1987,
      1992,
      1997,
      2002,
      2007
    ],
    "rules": {
      "lifeExp": {
        "min_exclusive": 0,
        "max_inclusive": 120
      },
      "pop": {
        "min_exclusive": 0
      },
      "gdpPercap": {
        "min_exclusive": 0
      }
    },
    "units": {
      "lifeExp": "years",
      "pop": "persons",
      "gdpPercap": "inflation-adjusted US dollars, following package documentation"
    }
  },
  "inputs": [
    {
      "file": "country_records.csv",
      "format": "csv",
      "raw_records": 1712,
      "source_to_canonical": {
        "CountryName": "country",
        "ContinentName": "continent",
        "ObservationYear": "year",
        "LifeYears": "lifeExp",
        "PopulationPersons": "pop",
        "GDPPerPerson": "gdpPercap"
      },
      "encoding": "cp1252",
      "separator": ";",
      "comment_prefix": "#",
      "ignore_columns": [
        "export_note"
      ]
    },
    {
      "file": "country_records.xlsx",
      "format": "xlsx",
      "raw_records": 1712,
      "source_to_canonical": {
        "country_name": "country",
        "continent_name": "continent",
        "observation_year": "year",
        "life_expectancy": "lifeExp",
        "population": "pop",
        "gdp_per_capita": "gdpPercap"
      },
      "sheet_name": "observations",
      "engine": "openpyxl"
    },
    {
      "file": "country_records.json",
      "format": "json",
      "raw_records": 1712,
      "source_to_canonical": {
        "identity.country": "country",
        "identity.continent": "continent",
        "identity.year": "year",
        "measures.lifeExp": "lifeExp",
        "measures.pop": "pop",
        "measures.gdpPercap": "gdpPercap"
      },
      "encoding": "utf-8",
      "record_path": "records",
      "normalization": "flatten identity and measures; metadata is not a record"
    },
    {
      "file": "country_records.parquet",
      "format": "parquet",
      "raw_records": 1712,
      "source_to_canonical": {
        "COUNTRY": "country",
        "CONTINENT": "continent",
        "YEAR": "year",
        "LIFE_EXP": "lifeExp",
        "POPULATION": "pop",
        "GDP_PER_CAPITA": "gdpPercap"
      },
      "engine": "pyarrow",
      "note": "Input columns are stored as strings; validate before conversion."
    }
  ],
  "analysis": {
    "continent": "Asia",
    "history_country": "Philippines"
  },
  "matrix": {
    "countries": [
      "Philippines",
      "Indonesia",
      "Thailand"
    ],
    "years": [
      1982,
      1987,
      1992,
      1997,
      2002,
      2007
    ],
    "baseline_year": 1982
  },
  "exports": {
    "csv": "canonical.csv",
    "xlsx": "canonical.xlsx",
    "json": "canonical.json",
    "parquet": "canonical.parquet"
  },
  "export_sheet": "observations",
  "expected": {
    "per_file": {
      "raw_rows": 1712,
      "rejected_rows": 6,
      "valid_before_deduplication": 1706,
      "exact_duplicates_removed": 2,
      "canonical_rows": 1704
    },
    "controls": {
      "countries": 142,
      "philippines_rows": 12,
      "asia_2007_rows": 33,
      "asia_2007_population": 3811953827,
      "philippines_2007_population": 91077287,
      "year": 2007
    }
  }
}